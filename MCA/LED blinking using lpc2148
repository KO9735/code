#include <lpc214x.h>

#define LED_MASK 0xFF000000
#define LED0 24

void delay(unsigned int time)
{
    unsigned int i, j;

    for(i = 0; i < time; i++)
    {
        for(j = 0; j < 5000; j++);
    }
}

int main(void)
{
    PINSEL2 = 0;
    IO1DIR = LED_MASK;

    while(1)
    {
        IO1SET = LED_MASK;
        delay(1500);

        IO1CLR = LED_MASK;
        delay(1500);
    }
}

